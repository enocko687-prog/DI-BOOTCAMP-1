<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Browse and search fascinating facts from The Fact File.">
  <title><%= title || 'Facts Feed Reader' %></title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <style>
    :root {
      --fact-ink: #24322d;
      --fact-green: #176b54;
      --fact-paper: #f7f5ed;
    }

    body {
      min-height: 100vh;
      background: var(--fact-paper);
      color: var(--fact-ink);
    }

    .navbar {
      background: #24322d;
    }

    .navbar-brand,
    .navbar .nav-link {
      color: #fffdf7;
    }

    .navbar .nav-link:hover,
    .navbar .nav-link.active {
      color: #b8e2c7;
    }

    .page-heading {
      font-family: Georgia, 'Times New Roman', serif;
    }

    .fact-post {
      border: 1px solid #d9ddd5;
      border-left: 4px solid var(--fact-green);
      border-radius: 4px;
      background: #fffdf8;
    }

    .fact-post a {
      color: var(--fact-green);
    }

    .fact-meta {
      color: #68716a;
      font-size: 0.9rem;
    }

    .site-footer {
      border-top: 1px solid #d9ddd5;
      color: #68716a;
    }
  </style>
</head>